{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://difvvdmelbtjxxvpjuvw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "advisable-mcp",
      "version": "0.2.0",
      "title": "Advisable"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "List services",
        "description": "List Advisable services (digital agency, technology, venture studio, etc.) with slugs and titles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "language": {
              "default": "en",
              "description": "Language code for titles.",
              "type": "string",
              "enum": [
                "en",
                "el",
                "es",
                "fr",
                "it",
                "de"
              ]
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List products",
        "description": "List Advisable products (Ecommercen, SizeTheMarket, Findloom, e-Prescription, Recommendable).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "search_insights",
        "title": "Search insights",
        "description": "Search Advisable insights/blog articles by keyword. Returns slug, title, excerpt, and published date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Keyword to search titles and excerpts."
            },
            "language": {
              "default": "en",
              "type": "string",
              "enum": [
                "en",
                "el",
                "es",
                "fr",
                "it",
                "de"
              ]
            },
            "limit": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "latest_news",
        "title": "Latest news",
        "description": "Get the latest news posts from Advisable (including synced Instagram posts).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "List clients",
        "description": "List Advisable's clients / case-study companies with slug, industry, country, and website.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "industry": {
              "description": "Optional industry filter.",
              "type": "string"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_article",
        "title": "Get article",
        "description": "Fetch the full record of one insight or news article by slug, including the HTML content of a given language. Use this before updating an article so you can edit its existing content.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "insight",
                "news"
              ],
              "description": "Which collection the article lives in."
            },
            "slug": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "default": "en",
              "type": "string",
              "enum": [
                "en",
                "el",
                "es",
                "fr",
                "it",
                "de"
              ]
            }
          },
          "required": [
            "kind",
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "upsert_insight",
        "title": "Create or update an insight",
        "description": "Create a new insight/blog article, or update an existing one (matched by slug), for one language. Content is HTML (headings, paragraphs, <img>, lists, tables). Requires an admin account.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "URL slug, e.g. 'ai-agents-for-ecommerce-2026'."
            },
            "language": {
              "default": "en",
              "description": "Language of title/excerpt/content.",
              "type": "string",
              "enum": [
                "en",
                "el",
                "es",
                "fr",
                "it",
                "de"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "excerpt": {
              "description": "Short summary shown in listings.",
              "type": "string"
            },
            "content": {
              "description": "Full article body as HTML.",
              "type": "string"
            },
            "featured_image": {
              "description": "Public image URL (use upload_image first).",
              "type": "string",
              "format": "uri"
            },
            "category": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "type": {
              "description": "Article type, e.g. 'insight'.",
              "type": "string"
            },
            "published_date": {
              "description": "ISO date, e.g. '2026-08-13'. Defaults to today on create.",
              "type": "string"
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "upsert_news",
        "title": "Create or update a news item",
        "description": "Create a new news item (article or media post), or update an existing one (matched by slug), for one language. Content is HTML. Requires an admin account.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "default": "en",
              "type": "string",
              "enum": [
                "en",
                "el",
                "es",
                "fr",
                "it",
                "de"
              ]
            },
            "type": {
              "default": "article",
              "description": "News type.",
              "type": "string",
              "enum": [
                "article",
                "media"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "excerpt": {
              "type": "string"
            },
            "content": {
              "description": "Full body as HTML.",
              "type": "string"
            },
            "featured_image": {
              "description": "Public image URL (use upload_image first).",
              "type": "string",
              "format": "uri"
            },
            "thumbnail_url": {
              "type": "string",
              "format": "uri"
            },
            "video_url": {
              "type": "string",
              "format": "uri"
            },
            "published_date": {
              "description": "ISO date. Defaults to today on create.",
              "type": "string"
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "upload_image",
        "title": "Upload image",
        "description": "Upload an image to Advisable storage and get back a public URL to use as a featured image or inside article HTML. Provide either source_url (image is fetched and re-hosted) or base64 data.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1,
              "description": "File name with extension, e.g. 'tiktok-shop-hero.jpg'."
            },
            "bucket": {
              "default": "blog-images",
              "description": "Target storage bucket.",
              "type": "string",
              "enum": [
                "blog-images",
                "news-media",
                "images"
              ]
            },
            "source_url": {
              "description": "Public URL of the image to re-host.",
              "type": "string",
              "format": "uri"
            },
            "base64": {
              "description": "Base64-encoded image data (no data: prefix needed).",
              "type": "string"
            },
            "content_type": {
              "description": "MIME type, e.g. image/jpeg. Inferred when omitted.",
              "type": "string"
            }
          },
          "required": [
            "filename"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
